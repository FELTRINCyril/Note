    "lock.lockedNote.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The content, attachments, and the list preview stay hidden while the note is locked."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le contenu, les pièces jointes et l'extrait dans la liste restent masqués tant que la note est verrouillée."
