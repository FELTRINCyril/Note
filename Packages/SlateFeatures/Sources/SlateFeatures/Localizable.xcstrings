    "lock.setPassword.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single password protects all your locked notes. Slate cannot recover it: write it down somewhere safe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul mot de passe protège toutes vos notes verrouillées. Slate ne peut pas le récupérer : notez-le ailleurs."
          }
        }
      }
    },
